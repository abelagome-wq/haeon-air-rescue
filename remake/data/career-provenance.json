  "rules": {
    "equipmentScope": "profile-wide; automatically fitted to every owned aircraft, not bought separately per aircraft",
    "cannonRequires": [
      "bucket"
    ],
    "spotlight": "not one of the five purchasable tools; baseline flight equipment",
    "newProfile": "1000 cash plus Schweizer, bucket, megaphone",
    "legacyMigration": "Preserve simcopter.record.cash exactly, including zero/negative/fractional values. No additional 1000. Give the same starter airframe/tools; never modify the legacy record.",
    "apache": "Original catalog offers eight civil aircraft; its UI index 8 is equipment. Apache has native helicopter index2 and HELI.TWK NewCost=50000 but is omitted from the ordinary catalog mapping [4,0,1,8,3,5,6,7]. The exact special acquisition condition was not established in this audit. Parent-authorized remake policy: allow a normal 50000 purchase, label it as a special original aircraft."
  },
